# LLM API keys (at least one required for live runs)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# OpenAI-only setup: set MODEL_PROFILE_ACCURATE=gpt-4o
# Anthropic-only setup: set all profiles to Claude models

# Model profile overrides (optional)
# Profiles: fast | balanced | accurate
MODEL_PROFILE_FAST=gpt-4o-mini
MODEL_PROFILE_BALANCED=gpt-4o
MODEL_PROFILE_ACCURATE=claude-sonnet-4-20250514

# Default profile for agents without an explicit override
DEFAULT_PROFILE=balanced

# Pipeline settings
# 0 = unlimited revisions
MAX_REVISIONS=0
MAX_REPAIR_ATTEMPTS=2
