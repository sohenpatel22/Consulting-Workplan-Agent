# LLM API keys (at least one required for live runs)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Model (all agents use this single high-accuracy model)
MODEL=claude-opus-4-8
# OpenAI model used when MODEL is Claude but only OPENAI_API_KEY is set
FALLBACK_MODEL=gpt-5.5-pro

# Pipeline settings
# 0 = unlimited revisions
MAX_REVISIONS=0
MAX_REPAIR_ATTEMPTS=2
ENABLE_PROMPT_CACHE=true
# Raise if you see "Unterminated string" JSON errors on large WBS/RAID outputs
LLM_MAX_OUTPUT_TOKENS=16384
