<h1>Work Breakdown Structure</h1>
<p><strong>Project:</strong> {{ project_title }}<br />
<strong>Client:</strong> {{ client_name }}</p>
{% if has_confirmed_items %}
<p class="confirmed-legend"><em>* Items marked with * were shaped by confirmed planner questions before build.</em></p>
{% endif %}
{% if has_assumed_items %}
<p class="assumed-legend"><em>~ Items marked with ~ contain values assumed by the agent (not stated in the brief) — verify before use.</em></p>
{% endif %}
<h2>Work packages</h2>
<table>
  <thead>
    <tr>
      <th>WBS Code</th>
      <th>WBS Element Title</th>
      <th>Description / Scope of Work</th>
      <th>Key Deliverable</th>
      <th>Owner</th>
      <th>Duration</th>
      <th>Dependencies</th>
    </tr>
  </thead>
  <tbody>
  {% for wp in wbs.work_packages %}
    <tr{% if wp.from_confirmed_answer %} class="from-confirmed"{% elif wp.is_assumed %} class="from-assumed"{% endif %}>
      <td>{{ wp.wbs_code | cell }}</td>
      <td>{{ wp.wbs_element_title | cell }}</td>
      <td>{{ wp.description_scope | cell('not detailed at sign-off') }}</td>
      <td>{{ wp.key_deliverable | cell('not confirmed at sign-off') }}</td>
      <td>{{ wp.owner | cell('not assigned at sign-off') }}</td>
      <td>{{ wp.estimated_duration | cell('not estimated at sign-off') }}</td>
      <td>{{ wp.dependencies | cell('none identified') }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
