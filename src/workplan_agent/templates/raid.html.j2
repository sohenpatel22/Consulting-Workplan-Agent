<h1>RAID Log</h1>
<p><strong>Project:</strong> {{ project_title }}<br />
<strong>Client:</strong> {{ client_name }}</p>
{% if has_confirmed_items %}
<p class="confirmed-legend"><em>* Items marked with * were shaped by confirmed planner questions before build.</em></p>
{% endif %}
{% if has_assumed_items %}
<p class="assumed-legend"><em>~ Items marked with ~ contain values assumed by the agent (not stated in the brief) — verify before use.</em></p>
{% endif %}

<h2>Risks</h2>
<table>
  <thead>
    <tr>
      <th>ID</th><th>Title</th><th>Description</th><th>Status</th><th>Mitigation</th>
      <th>Owner</th><th>WBS Links</th>
    </tr>
  </thead>
  <tbody>
  {% for item in raid.risks %}
    <tr{% if item.from_confirmed_answer %} class="from-confirmed"{% elif item.is_assumed %} class="from-assumed"{% endif %}>
      <td>{{ item.id | cell }}</td>
      <td>{{ item.title | cell }}</td>
      <td>{{ item.description | cell('not detailed at sign-off') }}</td>
      <td>{{ item.status | cell }}</td>
      <td>{{ item.mitigation | cell('not yet defined') }}</td>
      <td>{{ item.owner | cell('not assigned at sign-off') }}</td>
      <td>{{ item.wbs_links | cell('not linked to WBS') }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>

<h2>Actions</h2>
<table>
  <thead>
    <tr>
      <th>ID</th><th>Title</th><th>Description</th><th>Status</th>
      <th>Owner</th><th>WBS Links</th><th>Priority</th>
    </tr>
  </thead>
  <tbody>
  {% for item in raid.actions %}
    <tr{% if item.from_confirmed_answer %} class="from-confirmed"{% elif item.is_assumed %} class="from-assumed"{% endif %}>
      <td>{{ item.id | cell }}</td>
      <td>{{ item.title | cell }}</td>
      <td>{{ item.description | cell('not detailed at sign-off') }}</td>
      <td>{{ item.status | cell }}</td>
      <td>{{ item.owner | cell('not assigned at sign-off') }}</td>
      <td>{{ item.wbs_links | cell('not linked to WBS') }}</td>
      <td>{{ item.priority | cell }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>

<h2>Issues</h2>
<table>
  <thead>
    <tr>
      <th>ID</th><th>Title</th><th>Description</th><th>Resolution</th>
      <th>Owner</th><th>Priority</th>
    </tr>
  </thead>
  <tbody>
  {% if raid.issues %}
    {% for item in raid.issues %}
    <tr{% if item.from_confirmed_answer %} class="from-confirmed"{% elif item.is_assumed %} class="from-assumed"{% endif %}>
      <td>{{ item.id | cell }}</td>
      <td>{{ item.title | cell }}</td>
      <td>{{ item.description | cell('not detailed at sign-off') }}</td>
      <td>{{ item.resolution | cell('pending resolution') }}</td>
      <td>{{ item.owner | cell('not assigned at sign-off') }}</td>
      <td>{{ item.priority | cell }}</td>
    </tr>
    {% endfor %}
  {% else %}
    <tr><td>—</td><td>No issues identified</td><td colspan="4">n/a</td></tr>
  {% endif %}
  </tbody>
</table>

<h2>Decisions</h2>
<table>
  <thead>
    <tr>
      <th>ID</th><th>Title</th><th>Description / Justification</th><th>Resolution</th>
      <th>Owner</th><th>Priority</th>
    </tr>
  </thead>
  <tbody>
  {% for item in raid.decisions %}
    <tr{% if item.from_confirmed_answer %} class="from-confirmed"{% elif item.is_assumed %} class="from-assumed"{% endif %}>
      <td>{{ item.id | cell }}</td>
      <td>{{ item.title | cell }}</td>
      <td>{{ item.description_justification | cell('not detailed at sign-off') }}</td>
      <td>{{ item.resolution | cell('pending resolution') }}</td>
      <td>{{ item.owner | cell('not assigned at sign-off') }}</td>
      <td>{{ item.priority | cell }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
