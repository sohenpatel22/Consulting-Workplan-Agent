          "type": "string",
          "required": true,
          "description": "Derived overall rating: High, Moderate, or Low"
        },
        {
          "name": "risk_appetite",
          "type": "string",
          "required": true,
          "description": "Engagement risk appetite (e.g. Moderate)"
        },
        {
          "name": "priority",
          "type": "string",
          "required": true,
          "description": "Response level: Monitor closely, Monitor, Stay informed, or Respond as required"
        }
